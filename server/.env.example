# Sleek API configuration. Copy to .env (never commit real values).
NODE_ENV=production
PORT=8080
TZ=Africa/Lagos
DATABASE_URL=postgres://sleek:CHANGE_ME@db.internal:5432/sleek
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
# paystack in production; mock is refused when NODE_ENV=production
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_CALLBACK_URL=sleek://payment-complete
CUSTOMER_EMAIL_DOMAIN=customers.sleek.ng
PUBLIC_BASE_URL=https://api.sleek.ng
